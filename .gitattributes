# Preserve the published dependency's CRLF files when checking local patches.
vendor/crossterm/** whitespace=cr-at-eol
# Keep upstream Markdown byte-for-byte, including its trailing spaces.
vendor/crossterm/**/*.md whitespace=cr-at-eol,-blank-at-eol
# Preserve published Unicode manifest and generated conformance data verbatim.
vendor/unicode-segmentation/Cargo.toml.orig whitespace=-blank-at-eol,-blank-at-eof
vendor/unicode-segmentation/tests/testdata/mod.rs whitespace=-blank-at-eof
# Recorded upstream fixtures are verified by raw SHA-256 on every platform.
tests/fixtures/vscode-cpp-configuration/** -text
# Differential captures embed hashes of both reference sources and recorded data.
tests/vscode-reference/** -text
# Preserve source-hashed candidate inputs on Windows checkouts.
/tests/vscode-reference-save-actions-stable-configuration-candidate/** -text
# Preserve genuine Windows capture log CRLF without whitespace normalization.
/tests/vscode-reference/observations/1.95.0/save-configuration-stable/1338970/win32/**/capture.log whitespace=cr-at-eol
# Preserve the earlier immutable Windows readiness/migration terminal logs.
/tests/vscode-reference/observations/1.95.0/save-participant-readiness/2c5ee40/win32/**/capture.log whitespace=cr-at-eol
/tests/vscode-reference/observations/1.95.0/save-configuration-diagnostics/67ab795/win32/**/capture.log whitespace=cr-at-eol
# Bind the corrected sticky observer to exact source bytes on all platforms.
/tests/vscode-reference-sticky-monotonic-candidate/** -text
