{
  "publisher": "fixture",
  "name": "configuration-update",
  "version": "1.0.0",
  "main": "main.cjs",
  "engines": {
    "vscode": "*"
  },
  "contributes": {
    "configuration": {
      "properties": {
        "fixture.value": {
          "default": "default",
          "scope": "language-overridable"
        }
      }
    },
    "commands": [
      {
        "command": "fixture.configuration.roundtrip",
        "title": "Write extension configuration"
      },
      {
        "command": "fixture.configuration.language",
        "title": "Write language configuration"
      },
      {
        "command": "fixture.configuration.refused",
        "title": "Refuse dirty configuration"
      },
      {
        "command": "fixture.configuration.clean",
        "title": "Refresh open configuration"
      },
      {
        "command": "fixture.configuration.race",
        "title": "Preserve late configuration edits"
      }
    ]
  }
}
