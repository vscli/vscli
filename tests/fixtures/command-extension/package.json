{
  "name": "command-fixture",
  "publisher": "vscli-test",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "fixture.sort",
        "title": "Fixture Sort Lines"
      },
      {
        "command": "fixture.invalid",
        "title": "Fixture Invalid Transaction"
      },
      {
        "command": "fixture.stale",
        "title": "Fixture Stale Edit"
      },
      {
        "command": "fixture.crash",
        "title": "Fixture Crash"
      },
      {
        "command": "fixture.unsupported",
        "title": "Fixture Unsupported API"
      },
      {
        "command": "fixture.version",
        "title": "Fixture Report Version"
      }
    ],
    "keybindings": [
      {
        "key": "f9",
        "command": "fixture.sort",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "properties": {
        "fixture.value": {
          "type": "string",
          "default": "default"
        }
      }
    }
  }
}
